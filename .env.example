# DeepSeek Responses API (copy values to the process environment; never commit a real key)
OPENAI_API_KEY=replace-me
OPENAI_MODEL=deepseek-flash
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_STYLE=responses
OPENAI_TEMPERATURE=0

# Optional EEGAgent paper-code compatible DashScope/Qwen alternative
# OPENAI_API_KEY=replace-with-dashscope-key
# OPENAI_MODEL=qwen3-235b-a22b
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_API_STYLE=chat_completions
# OPENAI_ENABLE_THINKING=false

# Optional override for the supplied EEGAgent repository.
EEG_AGENT_REFERENCE_ROOT=D:\Profession\Programs\CANKAO\EEGAgent-main\EEGAgent-main
